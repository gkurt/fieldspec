{
  "name": "fieldspec",
  "version": "0.1.0",
  "description": "A typed, serializable, headless format for configs and the forms that edit them.",
  "keywords": [
    "config",
    "forms",
    "json-render",
    "json-schema",
    "react",
    "schema",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://gkurt.com/fieldspec/",
  "bugs": {
    "url": "https://github.com/gkurt/fieldspec/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "url": "https://gkurt.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/fieldspec.git"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "fieldspec@dev": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "source": "./src/index.ts"
    },
    "./react": {
      "fieldspec@dev": "./src/react/index.tsx",
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "source": "./src/react/index.tsx"
    },
    "./zod": {
      "fieldspec@dev": "./src/zod.ts",
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "source": "./src/zod.ts"
    },
    "./js": {
      "fieldspec@dev": "./src/js.ts",
      "import": {
        "types": "./dist/js.d.ts",
        "default": "./dist/js.js"
      },
      "source": "./src/js.ts"
    },
    "./schema.json": "./schema/spec.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite site",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "bun test --conditions=fieldspec@dev",
    "checks": "bun check && bun typecheck && bun run test",
    "build": "tsdown",
    "prepack": "tsdown",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./schema.json",
    "stress": "bun test/stress/explore.ts && bun test/stress/fuzz.ts 0 1000",
    "schema": "bun scripts/schema.ts",
    "demo": "vite demo --port 4192",
    "site:build": "vite build site",
    "tegami": "bun scripts/tegami.mts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@gkurt/quickjs-wasi": "^0.3.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@internationalized/date": "^3.12.4",
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "@json-render/shadcn": "0.21.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "8",
    "dialkit": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "motion": "^14.9.0",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tegami": "^1.5.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@gkurt/quickjs-wasi": "^0.3.0",
    "react": ">=19",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "@gkurt/quickjs-wasi": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
