{
  "name": "fieldspec",
  "version": "0.1.0",
  "description": "A typed, serializable, headless format for configs and the forms that edit them.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "forms",
    "config",
    "schema",
    "json-schema",
    "zod",
    "react",
    "validation",
    "typescript",
    "json-render",
    "dialkit",
    "react-aria"
  ],
  "homepage": "https://gkurt.com/fieldspec/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/fieldspec.git"
  },
  "bugs": "https://github.com/gkurt/fieldspec/issues",
  "author": "Gokhan Kurt",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./dialkit": {
      "types": "./dist/dialkit.d.ts",
      "default": "./dist/dialkit.js"
    },
    "./react-aria": {
      "types": "./dist/react-aria.d.ts",
      "default": "./dist/react-aria.js"
    },
    "./schema.json": "./schema/spec.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "stress": "bun test/stress/explore.ts && bun test/stress/fuzz.ts 0 1000",
    "typecheck": "tsc",
    "build": "bun scripts/build.ts",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./schema.json",
    "prepack": "bun scripts/build.ts",
    "schema": "bun scripts/schema.ts",
    "demo": "vite demo --port 4192",
    "site": "vite site",
    "site:build": "vite build site"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=4",
    "dialkit": ">=2",
    "react-aria-components": ">=1.22",
    "@internationalized/date": ">=3.12"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "dialkit": {
      "optional": true
    },
    "react-aria-components": {
      "optional": true
    },
    "@internationalized/date": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@happy-dom/global-registrator": "21.0.4",
    "@internationalized/date": "^3.12.4",
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "@json-render/shadcn": "0.21.3",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "8",
    "dialkit": "^2.1.0",
    "motion": "^14.9.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
