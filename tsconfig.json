{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleDetection": "force",

    "types": ["bun", "vite/client"],
    // Resolve fieldspec's own entry points to source, as tests and the site run it.
    "customConditions": ["fieldspec@dev"],

    "jsx": "react-jsx",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    // tsc never emits (noEmit), but tsdown reads `declarationMap` for .d.ts source maps; it requires `declaration`.
    "declaration": true,
    "declarationMap": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "test", "examples", "demo/src", "site/src", "scripts", "tsdown.config.ts"]
}
